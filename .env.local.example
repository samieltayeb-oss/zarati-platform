# Supabase — copy to .env.local and fill in your values
# Find these in: Supabase Dashboard → Project Settings → API

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin dashboard password (required — set a strong value in production)
ADMIN_PASSWORD=change-me-in-production

# Public site URL — used in email templates (logo, CTA, footer links)
# Set this to your deployed URL; no trailing slash
SITE_URL=https://zarati-platform.vercel.app

# Resend — transactional email (https://resend.com)
# Required for welcome emails and admin notifications
RESEND_API_KEY=re_your_api_key_here
# Must be a verified sender in your Resend account
RESEND_FROM=Zarati <sam@nexorayyc.io>
# Where new-signup admin notifications are sent
ADMIN_EMAIL=sam@nexorayyc.io
NEXT_PUBLIC_SUPABASE_URL=your_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
UPSTASH_REDIS_REST_URL=your_upstash_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# R4-B weather route now uses MET Norway. Keep OFF until a separate production gate.
# No API key required. Server identification uses the real ZARATI GitHub project URL.
# The retired Open-Meteo cron path cannot be enabled by this flag.
R4B_WEATHER_FEED_ENABLED=false

import { createAdminClient } from '../lib/supabase/server';
import { normalizeObservation } from '../lib/normalization/engine';

async function findBlocked() {
  const supabase = createAdminClient();
  const allObs: any[] = [];
  let page = 0;
  while(true) {
    const { data } = await supabase.from('market_price_observations').select('id, raw_unit_text').neq('publication_status', 'RETRACTED').range(page * 1000, (page + 1) * 1000 - 1);
    if (!data || data.length === 0) break;
    allObs.push(...data);
    page++;
  }
  console.log("Total scanned:", allObs.length);
  for (const o of allObs) {
    try {
      const res = await normalizeObservation(o.id, 'PARALLEL_MARKET');
      if (res.unit_resolution_method === null) {
        console.log('Blocked:', o.id, o.raw_unit_text);
      }
    } catch (e) {
      console.log('Blocked by Error:', o.id, (e as Error).message);
    }
  }
}
findBlocked().catch(console.error);
